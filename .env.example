# =============================================================================
# Pastelería Online — environment variables
# -----------------------------------------------------------------------------
# How to use:
#   1. Copy this file to `.env.local` (git-ignored).
#   2. Fill in the real values obtained from the Supabase project dashboard.
#   3. Never commit real credentials.
#
# All values below are PLACEHOLDERS. No real credentials are stored in this
# repository. The Supabase project is not created yet (see docs/ROADMAP.md).
# =============================================================================

# ─── Public variables (exposed to the browser) ───────────────────────────────
# Supabase project URL. Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key. It is safe to ship to the browser ONLY because
# Row Level Security protects every table. Never use it for privileged writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Server-only variables (never exposed to the browser) ────────────────────
# Supabase service-role API key. It bypasses Row Level Security, so it must only
# be read from server code (src/infrastructure/supabase/admin.ts, guarded by
# `server-only`). Do NOT prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Unified worker runtime (BCV + OQ-16; backend only) ──────────────────────
# Single Render Web Service / single process / single HTTP server.
# Requires NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for both workers.
# Render Free Web Service:
#   Build command: npm ci
#   Start command: node supabase/worker/runtime.mjs
#   Health check:  GET /healthz (port provided by Render via PORT)
# The health endpoint returns minimal non-sensitive JSON and never triggers cycles.

# BCV automatic sync: Monday-Friday 09:00 and 13:00 America/Caracas.
# Missed slots are intentionally not replayed after restart.
BCV_SYNC_FETCH_TIMEOUT_MS=15000
BCV_SYNC_SHUTDOWN_TIMEOUT_MS=10000
# Testing only: fixed delay (ms) between BCV sync cycles. When set, overrides
# the 09:00/13:00 Caracas schedule. Leave unset in Staging/Production.
# BCV_SYNC_TEST_INTERVAL_MS=120000

# OQ-16 receipt-SLA: immediate startup cycle, then 15-minute polling.
SLA_POLL_MS=900000
SLA_SHUTDOWN_TIMEOUT_MS=10000
